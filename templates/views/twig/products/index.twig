{% extends "../layouts/base.twig" %}
{% block content %}
<h1>Products</h1>
<table>
  <thead><tr><th>ID</th><th>Name</th><th>Price</th></tr></thead>
  <tbody>
{% for product in products %}    <tr><td>{{ product.id }}</td><td>{{ product.name }}</td><td>{{ product.price }}</td></tr>
{% endfor %}  </tbody>
</table>
{% endblock %}
